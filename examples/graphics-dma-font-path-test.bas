' Compare text rendered into a graphics window with the console text path.
CONST KOptMathSingle = 1
OPTION KOptMathSingle

GUPDATE 0
WINDOW #1,0,0,320,176
PAPER #1,0
INK #1,4
CLS #1
PRINT #1,"GRAPHICS: ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789"
GUPDATE
PRINT "CONSOLE: ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789"
